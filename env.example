# 이 파일을 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
# 로그인 토큰을 서명하는 키. 32자 이상의 무작위 문자열을 넣는다. 만드는 법: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=여기에-긴-무작위-문자열
# development 또는 production. Docker 이미지는 production으로 돌며, 그때 SECRET_KEY가 기본값이거나 32자보다 짧으면 서버가 시작하지 않는다.
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 공급자. gemini 또는 anthropic. 고른 공급자의 키가 없으면 AI 기능은 503으로 안내하고 모킹하지 않는다.
AI_PROVIDER=gemini

# Gemini. 키는 https://aistudio.google.com/apikey 에서 무료로 만든다. 무료 등급은 입력 내용이 Google 제품 개선에 쓰인다.
# 사고 수준을 low, medium, high로 넘기므로 이를 지원하는 Gemini 3 계열 모델을 쓴다.
# 2026-11-10 측정에서 gemini-3.8-flash는 무료 등급 응답이 수 분 걸리거나 504, gemini-3.6-flash는 503이었고 gemini-3.5-flash-lite만 정상이었다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI 호출 한 번의 제한 시간, 초
AI_TIMEOUT_SECONDS=60

# Anthropic. AI_PROVIDER=anthropic 일 때만 쓴다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google 문서 연동. 자리 2 과제에서만 필요하다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
# 소셜 로그인. 값이 없는 공급자는 로그인 화면에 버튼이 나오지 않는다.
# Google 은 위의 GOOGLE_CLIENT_ID 와 GOOGLE_CLIENT_SECRET 을 같이 쓰고, Google Cloud 콘솔의 승인된 리디렉션 URI 에
# OAUTH_REDIRECT_BASE 뒤에 /api/auth/social/google/callback 을 붙인 주소를 더한다.
# GitHub 는 Settings, Developer settings, OAuth Apps 에서 앱을 만들고 콜백 주소에
# OAUTH_REDIRECT_BASE 뒤에 /api/auth/social/github/callback 을 붙인 주소를 넣는다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 소셜 로그인 공급자가 돌아올 이 서버의 주소. 배포하면 외부에서 접속하는 주소로 바꾼다.
OAUTH_REDIRECT_BASE=http://localhost:8000
# Google 문서 연동과 소셜 로그인 뒤 돌아갈 프런트엔드 주소. 비우면 같은 서버의 상대 경로로 돌아간다. 개발 중에는 http://localhost:5173
PUBLIC_URL=
