# 이 파일을 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
SECRET_KEY=여기에-긴-무작위-문자열
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 공급자. gemini 또는 anthropic. 고른 공급자의 키가 없으면 AI 기능은 503으로 안내하고 모킹하지 않는다.
AI_PROVIDER=gemini

# Gemini. 키는 https://aistudio.google.com/apikey 에서 무료로 만든다. 무료 등급은 입력 내용이 Google 제품 개선에 쓰인다.
# 사고 수준을 low, medium, high로 넘기므로 이를 지원하는 Gemini 3 계열 모델을 쓴다.
# 2026-11-10 측정에서 gemini-3.8-flash는 무료 등급 응답이 수 분 걸리거나 504, gemini-3.6-flash는 503이었고 gemini-3.5-flash-lite만 정상이었다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI 호출 한 번의 제한 시간, 초
AI_TIMEOUT_SECONDS=60

# Anthropic. AI_PROVIDER=anthropic 일 때만 쓴다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google 문서 연동. 자리 2 과제에서만 필요하다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# 자리 4 보고서(docx) 편집기. scripts/onlyoffice.sh 로 Document Server 를 띄우고 같은 비밀값을 넣는다.
ONLYOFFICE_PUBLIC_URL=http://localhost:8080
ONLYOFFICE_INTERNAL_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=
# Document Server 컨테이너에서 본 이 백엔드 주소. Colima 는 host.lima.internal, Docker Desktop 은 host.docker.internal
BACKEND_URL_FOR_ONLYOFFICE=http://host.lima.internal:8000
